<section class="rise" style="animation-delay: 220ms">
	<div class="mb-3 flex items-center justify-between px-1">
		<h2 class="text-xs font-bold tracking-wider uppercase text-ink-400">Archives // Terminés</h2>
		<span id="done-count" class="font-mono text-[10px] font-bold px-2 py-0.5 rounded border-2 border-black bg-success text-black tabular-nums shadow-[2px_2px_0px_#000]">0</span>
	</div>
	<p
		id="done-empty"
		class="rounded border-2 border-dashed border-ink-800 bg-black/10 px-4 py-8 text-center text-xs text-ink-500 italic"
	>
		Aucun archivage enregistré
	</p>
	<ul
		id="done-list"
		class="divide-y-2 divide-black rounded border-2 border-black bg-black/20 empty:hidden overflow-hidden"
	>
	</ul>
</section>
