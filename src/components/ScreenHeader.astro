---
// Titre d'écran (h1) avec l'animal de la section ; la description est facultative.
import Animal from './Animal.astro';

interface Props {
  animal: string;
  title: string;
  description?: string;
}
const { animal, title, description } = Astro.props;
---

<div>
  <div class="flex items-center gap-3">
    <Animal id={animal} class="size-8 shrink-0 text-fg" />
    <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
  </div>
  {description && <p class="mt-1.5 text-base text-muted">{description}</p>}
</div>
