---
// Ajout de liens : un grand champ, un bouton Télécharger, options repliées.
---

<form id="add-form" class="panel flex flex-col gap-3 !p-6" novalidate>
  <h1 class="text-2xl font-semibold tracking-tight"><label for="add-urls">Collez un lien</label></h1>
  <textarea
    id="add-urls"
    class="field h-20 resize-none py-3 text-base leading-snug"
    placeholder="https://exemple.com/ma-video"
    spellcheck="false"
    autocomplete="off"
    aria-describedby="add-help"
    rows="2"
  ></textarea>
  <p id="add-help" class="field-help">Lien de la page où se trouve la vidéo, ou lien direct (.m3u8, .mp4).</p>

  <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
    <button id="add-options-toggle" type="button" class="disclosure" aria-expanded="false" aria-controls="add-options">Options</button>
    <div class="flex items-center gap-4">
      <span id="add-hint" class="text-sm text-muted" hidden>Entrée pour lancer</span>
      <button id="add-submit" type="submit" class="button-primary button-lg">Télécharger</button>
    </div>
  </div>

  <div id="add-options" class="grid gap-4 border-t border-border pt-4 sm:grid-cols-2" hidden>
    <div>
      <label class="field-label mb-1.5" for="add-filename">Nom du fichier</label>
      <input id="add-filename" class="field" type="text" placeholder="Laisser vide pour un nom automatique" autocomplete="off" />
      <p id="add-filename-help" class="field-help mt-1.5">Sans extension. Pour un seul lien.</p>
    </div>
    <div>
      <label class="field-label mb-1.5" for="add-referer">Referer</label>
      <input id="add-referer" class="field" type="text" placeholder="https://exemple.com/" autocomplete="off" spellcheck="false" />
      <p class="field-help mt-1.5">Seulement si le site refuse le téléchargement.</p>
    </div>
  </div>
</form>
