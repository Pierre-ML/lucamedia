---
// Formulaire d'ajout : un lien par ligne (page, m3u8 ou mp4).
---

<form id="add-form" class="panel flex flex-col gap-4">
  <div>
    <label class="field-label" for="add-urls">Liens à télécharger</label>
    <textarea
      id="add-urls"
      class="field !h-28 resize-y py-2 font-mono text-xs leading-relaxed"
      placeholder="https://exemple.com/video&#10;https://exemple.com/flux/master.m3u8"
      spellcheck="false"
      autocomplete="off"
    ></textarea>
    <p class="mt-1.5 text-xs text-muted">Un lien par ligne. Collez le lien de la page ou du flux : Ursa trouve la vidéo et prend la meilleure qualité.</p>
  </div>

  <details>
    <summary class="cursor-pointer select-none text-xs text-muted transition-colors hover:text-fg">Options facultatives</summary>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div>
        <label class="field-label" for="add-filename">Nom du fichier</label>
        <input id="add-filename" class="field" type="text" placeholder="Nom du fichier (sans extension)" autocomplete="off" />
      </div>
      <div>
        <label class="field-label" for="add-referer">Referer</label>
        <input id="add-referer" class="field" type="text" placeholder="https://exemple.com/" autocomplete="off" spellcheck="false" />
      </div>
    </div>
  </details>

  <div class="flex justify-end">
    <button id="add-submit" type="submit" class="button-primary">Ajouter</button>
  </div>
</form>
