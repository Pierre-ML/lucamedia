<section
	class="rise overflow-hidden brutalist-card brutalist-card-cyan"
	style="animation-delay: 120ms"
>
	<div class="flex items-center justify-between gap-3 border-b-2 border-black bg-black/10 py-2.5 px-4">
		<div class="flex items-center gap-4">
			<div class="terminal-bar">
				<span class="terminal-dot red"></span>
				<span class="terminal-dot yellow"></span>
				<span class="terminal-dot green"></span>
			</div>
			<h2 class="text-[10px] font-extrabold tracking-wider uppercase text-ink-300">Terminal // logs</h2>
		</div>
		<div class="flex gap-1.5">
			<button id="console-clear" type="button" class="btn-ghost font-display text-[9px] font-bold uppercase tracking-wider hover:bg-white/[0.04]">
				Effacer
			</button>
			<button id="console-toggle" type="button" class="btn-ghost font-display text-[9px] font-bold uppercase tracking-wider hover:bg-white/[0.04]" aria-controls="console-body">
				Masquer
			</button>
		</div>
	</div>
	<div
		id="console-body"
		class="max-h-60 overflow-y-auto bg-black/40 px-4 py-4 font-mono text-[11px] leading-relaxed break-all space-y-1 shadow-inner scrollbar-thin"
		style="font-family: var(--font-mono);"
	>
		<p class="console-placeholder text-ink-600 italic">// En attente du démarrage du terminal...</p>
	</div>
</section>
