---
import AddForm from './AddForm.astro';
import Animal from './Animal.astro';
---

<section data-screen="downloads" class="mx-auto flex w-full max-w-3xl flex-col gap-8" hidden>
  <AddForm />

  <div>
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
      <h2 class="mr-auto text-lg font-semibold">Téléchargements</h2>
      <span id="q-paused" class="pill bg-warning/15 text-warning" hidden>File en pause</span>
      <button id="q-pause" type="button" class="button-ghost button-sm" hidden>Mettre en pause</button>
      <button id="done-clear" type="button" class="button-ghost button-sm" hidden>Vider les terminés</button>
      <button id="q-open" type="button" class="button-ghost button-sm">Ouvrir le dossier</button>
    </div>

    <div id="dl-empty" class="flex flex-col items-center rounded-xl border border-dashed border-control-dim py-10 text-center">
      <Animal id="ours" class="mb-3 size-16 shrink-0 text-faint" />
      <p class="text-base text-muted">Vos téléchargements apparaîtront ici.</p>
    </div>
    <div id="dl-list" class="flex flex-col gap-3"></div>
  </div>

  <div id="owl-template" hidden><Animal id="hibou" class="size-5" /></div>
</section>
