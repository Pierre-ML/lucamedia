---
import ScreenHeader from './ScreenHeader.astro';
import Animal from './Animal.astro';
---

<section data-screen="logs" class="mx-auto flex h-full w-full max-w-4xl flex-col" hidden>
  <div class="mb-5 flex items-start justify-between gap-4">
    <ScreenHeader animal="corbeau" title="Journal" description="Ce que fait Lucamedia : recherche, téléchargement, vérification." />
    <button id="log-clear" type="button" class="button-ghost button-sm mt-1.5">Effacer</button>
  </div>
  <div class="relative min-h-48 flex-1">
    <div id="log-list" class="absolute inset-0 overflow-y-auto rounded-xl border border-border bg-code px-4 py-3 font-mono text-xs leading-relaxed"></div>
    <div id="log-empty" class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center">
      <Animal id="ours" class="mb-3 size-16 shrink-0 text-faint" />
      <p class="text-base text-muted">Le journal est vide.</p>
    </div>
  </div>
</section>
