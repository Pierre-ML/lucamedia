<section
	class="rise overflow-hidden brutalist-card brutalist-card-cyan"
	style="animation-delay: 100ms"
>
	<div class="flex items-center justify-between border-b-2 border-black px-5 py-4 bg-black/20">
		<h2 class="text-xs font-extrabold tracking-wider uppercase text-ink-300 flex items-center gap-2">
			<span class="relative flex size-2 shrink-0">
				<span class="animate-ping absolute inline-flex h-full w-full bg-cyber-cyan opacity-75"></span>
				<span class="relative inline-flex size-2 bg-cyber-cyan"></span>
			</span>
			Flux en cours //
		</h2>
		<span id="current-retries" class="hidden font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 border-2 border-black bg-cyber-yellow text-black tabular-nums shadow-[2px_2px_0px_#000]"></span>
	</div>

	<!-- État inactif -->
	<div id="current-empty" class="px-6 py-12 text-center flex flex-col items-center">
		<div class="relative mb-3 flex items-center justify-center">
			<span class="relative grid size-12 place-items-center bg-black/40 border-2 border-black text-ink-500">
				<svg class="size-6 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 17V3"></path>
					<path d="m6 11 6 6 6-6"></path>
					<path d="M19 21H5"></path>
				</svg>
			</span>
		</div>
		<p class="text-xs font-extrabold uppercase tracking-widest text-ink-300">Aucun flux actif //</p>
		<p class="mt-1 text-xs text-ink-500 max-w-xs font-semibold">
			Ajoutez des liens dans la file pour lancer le téléchargement.
		</p>
	</div>

	<!-- État actif -->
	<div id="current-card" class="hidden p-5 space-y-5">
		<div class="flex items-start justify-between gap-6">
			<div class="min-w-0 flex-1">
				<p id="current-name" class="truncate text-base font-extrabold text-ink-100 tracking-tight"></p>
				<p id="current-url" class="mt-1 truncate font-mono text-[10px] text-cyber-cyan font-bold" title=""></p>
			</div>
			<div class="shrink-0 flex items-baseline">
				<span
					id="current-percent"
					class="font-sans text-3xl font-black tracking-tight text-cyber-yellow tabular-nums [text-shadow:2px_2px_0px_#000]"
				>
				</span>
			</div>
		</div>

		<!-- Jauge de progression brutaliste -->
		<div class="h-5 w-full bg-black border-2 border-black p-[2px] overflow-hidden">
			<div id="current-bar" class="bar h-full" style="width: 0%"></div>
		</div>

		<!-- Télémétrie plate -->
		<dl class="grid grid-cols-2 gap-4">
			<div class="border-2 border-black bg-black/40 p-3 flex items-center gap-3 shadow-[3px_3px_0px_#000]">
				<div class="grid size-8 place-items-center bg-cyber-cyan border-2 border-black text-black font-black">
					<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
						<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
						<line x1="12" y1="22.08" x2="12" y2="12"></line>
					</svg>
				</div>
				<div class="min-w-0">
					<dt class="text-[10px] font-bold uppercase tracking-wider text-ink-500">Volume estimé</dt>
					<dd id="current-size" class="mt-0.5 font-mono text-xs font-bold text-ink-200 tabular-nums truncate">—</dd>
				</div>
			</div>
			
			<div class="border-2 border-black bg-black/40 p-3 flex items-center gap-3 shadow-[3px_3px_0px_#000]">
				<div class="grid size-8 place-items-center bg-accent border-2 border-black text-black font-black">
					<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
				</div>
				<div class="min-w-0">
					<dt class="text-[10px] font-bold uppercase tracking-wider text-ink-500">Temps restant</dt>
					<dd id="current-eta" class="mt-0.5 font-mono text-xs font-bold text-ink-200 tabular-nums truncate">—</dd>
				</div>
			</div>
		</dl>
	</div>
</section>
