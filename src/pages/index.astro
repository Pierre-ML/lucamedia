---
import App from '../layouts/App.astro';
import Sidebar from '../components/Sidebar.astro';
import UpdateBanner from '../components/UpdateBanner.astro';
import DownloadsScreen from '../components/DownloadsScreen.astro';
import LogsScreen from '../components/LogsScreen.astro';
import SettingsScreen from '../components/SettingsScreen.astro';
---

<App>
  <div class="flex h-screen w-screen">
    <Sidebar />

    <main class="flex min-w-0 flex-1 flex-col">
      <div id="browser-banner" class="border-b border-warning/40 bg-warning/10 px-6 py-2 text-center text-sm text-warning" hidden>
        Mode navigateur : le moteur d'Ursa est indisponible
      </div>
      <UpdateBanner />
      <div class="min-h-0 flex-1 overflow-y-auto px-8 py-7">
        <DownloadsScreen />
        <LogsScreen />
        <SettingsScreen />
      </div>
    </main>
  </div>

  <div id="toasts" class="pointer-events-none fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 flex-col items-center gap-2"></div>

  <script>
    import '../scripts/main';
  </script>
</App>
